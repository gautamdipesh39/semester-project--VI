# Copy this file to .env before using XAMPP MySQL.
SECRET_KEY=replace-with-a-long-random-secret
# XAMPP normally uses root with no password. Add one after root: if yours has a password.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/mediassist_ai
FLASK_DEBUG=false
# Flask website address: http://127.0.0.1:5050
PORT=5050
# Use a strong unique value before deploying. This is only used when the first Admin is created.
ADMIN_EMAIL=admin@mediassist.local
ADMIN_INITIAL_PASSWORD=ChangeMe123!
